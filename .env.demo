# Staging / demo environment (loaded by `vite --mode demo`).
#
# The only thing this switches is which IndexedDB database the app opens:
# `mx-learning-demo` instead of `mx-learning`. Your real deck is never
# opened by a demo build, so nothing you do here can corrupt it.
#
# Contains no secrets — safe to commit. `.env.local` is still loaded on top
# of this file, so your Mistral key keeps working in staging.
VITE_APP_ENV=demo
